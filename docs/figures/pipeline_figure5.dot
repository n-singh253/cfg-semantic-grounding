digraph PipelineSWExploitStyle {
  rankdir=LR;
  graph [
    fontname="Helvetica",
    fontsize=11,
    labelloc="t",
    label="Figure 5. CFG-Semantic Grounding Pipeline\nStructural Misalignment Detection for APR Patches",
    splines=ortho,
    nodesep=0.5,
    ranksep=0.7,
    compound=true
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#444444", penwidth=1.1];
  edge [fontname="Helvetica", fontsize=9, color="#444444", arrowsize=0.8];

  /* Top ribbon */
  Ribbon [
    label="Step 1: Patch Generation  |  Step 2: Attack Generation  |  Step 3: Defense + Evaluation",
    fillcolor="#e9f2ff", color="#4472c4", shape=box, style="rounded,filled", fontsize=10
  ];

  /* Inputs */
  subgraph cluster_inputs {
    label="Pipeline Inputs";
    color="#bdbdbd";
    style="rounded,filled";
    fillcolor="#f5f5f5";

    InInst [label="Dataset Instance\nSWE-Bench Lite / Pro / Plus\nrepo_id, base_commit, issue prompt", fillcolor="#f5f5f5", color="#9e9e9e"];
    InRepo [label="Repo Snapshot\nchecked-out codebase, test suite", fillcolor="#f5f5f5", color="#9e9e9e"];
    InCfg  [label="Config\nattack family, patch agent\ndefense mode", fillcolor="#f5f5f5", color="#9e9e9e"];
  }

  /* Phase 1: Original Patch Generation */
  subgraph cluster_p1 {
    label="1. Original Patch Generation";
    color="#3949ab";
    style="rounded,filled";
    fillcolor="#e8eaf6";

    P1Agent [label="APR Agent\nMiniSWEAgent, SWEAgent\nOpenHands, Claude Code\nGemini CLI", fillcolor="#e8eaf6", color="#3949ab"];
    P1Sig   [label="agent(repo_code,\nori_prompt, tests)", fillcolor="#e8eaf6", color="#3949ab", fontsize=9];

    P1Agent -> P1Sig;
  }

  /* Output: ori_patch */
  OriPatch [label="ori_patch", shape=ellipse, fillcolor="#fff8e1", color="#f57f17", penwidth=1.5];

  /* Phase 2: Adversarial Prompt Generation */
  subgraph cluster_p2 {
    label="2. Adversarial Prompt Generation";
    color="#c62828";
    style="rounded,filled";
    fillcolor="#fce4ec";

    P2Atk  [label="Attack Module\nBug Reports, UDora\nSWExploit, FCV", fillcolor="#fce4ec", color="#c62828"];
    P2Sig  [label="attack(repo_code,\nori_prompt, tests)", fillcolor="#fce4ec", color="#c62828", fontsize=9];
    P2Note [label="LLM-based\nfidelity_mode = llm", fillcolor="#fce4ec", color="#c62828", fontsize=8, style="rounded,filled,dashed"];

    P2Atk -> P2Sig;
  }

  /* Output: adv_prompt */
  AdvPrompt [label="adv_prompt", shape=ellipse, fillcolor="#fff8e1", color="#f57f17", penwidth=1.5];

  /* Phase 3: Attacked Patch Generation */
  subgraph cluster_p3 {
    label="3. Attacked Patch Generation";
    color="#3949ab";
    style="rounded,filled";
    fillcolor="#e8eaf6";

    P3Agent [label="APR Agent\nsame selectable agent family", fillcolor="#e8eaf6", color="#3949ab"];
    P3Sig   [label="agent(repo_code,\nadv_prompt, tests)", fillcolor="#e8eaf6", color="#3949ab", fontsize=9];

    P3Agent -> P3Sig;
  }

  /* Output: adv_patch */
  AdvPatch [label="adv_patch", shape=ellipse, fillcolor="#fff8e1", color="#f57f17", penwidth=1.5];

  /* Phase 4: Structural Misalignment Defense (largest cluster) */
  subgraph cluster_p4 {
    label="4. Structural Misalignment Defense";
    color="#00695c";
    style="rounded,filled";
    fillcolor="#e0f2f1";
    penwidth=2;

    D1 [label="CFG Diff Extraction\npatch vs. original repo\nchanged CFG nodes, CFG stats", fillcolor="#e0f2f1", color="#00695c"];
    D2 [label="Subtask Decomposition\nLLM derives subtasks\nfrom prompt", fillcolor="#e0f2f1", color="#00695c"];
    D3 [label="Subtask-to-CFG Grounding\nlink subtasks to\nchanged code regions", fillcolor="#e0f2f1", color="#00695c"];
    D4 [label="Structural Justification Features\ncoverage, justification_gap\nentropy, unmatched nodes/subtasks", fillcolor="#e0f2f1", color="#00695c"];
    D5 [label="ML-Based Accept/Reject\nsklearn classifier\nthreshold policy", fillcolor="#e0f2f1", color="#00695c"];

    D1 -> D2 -> D3 -> D4 -> D5;
  }

  /* Output: verdict */
  Verdict [label="accept / reject", shape=ellipse, fillcolor="#fff8e1", color="#f57f17", penwidth=1.5];

  /* Phase 5: Evaluation and Provenance */
  subgraph cluster_p5 {
    label="5. Evaluation and Provenance";
    color="#2e7d32";
    style="rounded,filled";
    fillcolor="#e8f5e9";

    P5Run [label="Patch apply, test suite\nbandit / semgrep, LLM judges", fillcolor="#e8f5e9", color="#2e7d32"];
    P5Out [label="results.jsonl, summary.csv\nintegration_spec.json", fillcolor="#e8f5e9", color="#2e7d32"];
    P5Art [label="Patch artifacts\ndefense artifacts, logs", fillcolor="#e8f5e9", color="#2e7d32"];

    P5Run -> P5Out -> P5Art;
  }

  /* Layout hint: ribbon at top */
  {rank=min; Ribbon;}
  {rank=same; InInst; InRepo; InCfg;}

  /* Edges: inputs to phases */
  Ribbon -> InInst [style=invis];
  InInst -> P1Agent [lhead=cluster_p1];
  InInst -> P2Atk  [lhead=cluster_p2];

  /* Phase 1 -> ori_patch */
  P1Sig -> OriPatch;

  /* Phase 2 -> adv_prompt -> Phase 3 -> adv_patch */
  P2Sig -> AdvPrompt;
  AdvPrompt -> P3Agent;
  P3Sig -> AdvPatch;

  /* Fork-join: both patches into defense */
  OriPatch -> D1 [lhead=cluster_p4, color="#3949ab", penwidth=1.5];
  AdvPatch -> D1 [lhead=cluster_p4, color="#c62828", penwidth=1.5];

  /* Defense -> verdict -> evaluation */
  D5 -> Verdict;
  Verdict -> P5Run [lhead=cluster_p5, color="#00695c", penwidth=1.5];
}
